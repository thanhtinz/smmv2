// SMMv2 — SMM Panel + Premium Shop
// Tiền tệ: VND lưu dạng Int (đồng) để tránh lỗi thập phân.
// Đổi sang Postgres: provider = "postgresql" + DATABASE_URL tương ứng.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  STAFF
  ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
}

// Cấp khách: chiết khấu % áp trên giá dịch vụ SMM
enum UserLevel {
  MEMBER // 0%
  RESELLER // 5%
  AGENCY // 10%
  VIP // 15%
}

model User {
  id             Int        @id @default(autoincrement())
  username       String     @unique @db.VarChar(50)
  email          String     @unique @db.VarChar(191)
  phone          String?    @db.VarChar(20)
  fullName       String?    @db.VarChar(100)
  passwordHash   String     @db.VarChar(191)
  role           Role       @default(USER)
  status         UserStatus @default(ACTIVE)
  level          UserLevel  @default(MEMBER)
  balance        Int        @default(0) // VND
  totalDeposited Int        @default(0)
  totalSpent     Int        @default(0)
  apiKey         String     @unique @db.VarChar(64)
  depositCode    String     @unique @db.VarChar(12) // nội dung CK: SMM <code>
  refCode        String?    @unique @db.VarChar(12) // mã giới thiệu (trang Kiếm tiền)
  webhookUrl     String?    @db.VarChar(255) // URL nhận thông báo trạng thái đơn (Webhook ra hệ thống ngoài của khách)
  referredById   Int? // người đã giới thiệu tài khoản này
  referredBy     User?      @relation("Referral", fields: [referredById], references: [id])
  referrals      User[]     @relation("Referral")
  lastLoginAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  smmOrders     SmmOrder[]
  premiumOrders PremiumOrder[]
  deposits      Deposit[]
  transactions  Transaction[]
  tickets       Ticket[]
  notifications Notification[]

  // Panel con (child panel): khách đăng ký qua panel của đại lý khác
  panelId    Int?
  panel      ChildPanel?  @relation("PanelMember", fields: [panelId], references: [id])
  ownedPanel ChildPanel?  @relation("PanelOwner")
}

enum Fulfillment {
  API // tự động đẩy qua nhà cung cấp
  MANUAL // admin xử lý tay trong hàng đợi
}

enum ProviderKind {
  SMM // chỉ dịch vụ social
  PREMIUM // chỉ sản phẩm (API mua sản phẩm kiểu ThaTim)
  BOTH // cả hai (vd ThaTim)
}

model Provider {
  id            Int          @id @default(autoincrement())
  kind          ProviderKind @default(BOTH)
  name          String       @db.VarChar(100)
  apiUrl        String   @db.VarChar(255) // vd https://slike.vn/api/v2
  apiKey        String   @db.VarChar(191)
  currency      String   @default("VND") @db.VarChar(10) // VND | USD
  exchangeRate  Int      @default(1) // 1 đơn vị tiền gốc = ? VND (USD: 26000)
  markupPercent Int      @default(30) // % cộng lãi khi đồng bộ dịch vụ
  balanceCache  Int      @default(0) // số dư quy VND, cập nhật khi check
  active        Boolean  @default(true)
  note          String?  @db.Text
  lastSyncAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  services      SmmService[] @relation("SmmMainProvider")
  backupServices SmmService[] @relation("SmmBackupProvider")
  orders        SmmOrder[]
  premiumProducts PremiumProduct[]
  premiumOrders   PremiumOrder[]
}

model SmmCategory {
  id       Int     @id @default(autoincrement())
  platform String  @db.VarChar(30) // facebook | tiktok | instagram | youtube | telegram | shopee | x | spotify | other
  name     String  @db.VarChar(120)
  sort     Int     @default(0)
  active   Boolean @default(true)

  services SmmService[]
}

enum SmmOrderStatus {
  PENDING
  PROCESSING
  IN_PROGRESS
  COMPLETED
  PARTIAL
  CANCELED
  REFUNDED
}

model SmmService {
  id               Int         @id @default(autoincrement())
  categoryId       Int
  category         SmmCategory @relation(fields: [categoryId], references: [id])
  name             String      @db.VarChar(255)
  description      String?     @db.Text
  rate             Int // giá bán / 1000 (VND, trước chiết khấu cấp khách)
  costRate         Int         @default(0) // giá vốn / 1000 (VND)
  min              Int         @default(10)
  max              Int         @default(100000)
  avgTime          String?     @db.VarChar(60) // "0-15 phút", "1-2 giờ"...
  refill           Boolean     @default(false)
  cancelable       Boolean     @default(false)
  dripfeed         Boolean     @default(false)
  fulfillment      Fulfillment @default(MANUAL)
  providerId       Int?
  provider         Provider?   @relation("SmmMainProvider", fields: [providerId], references: [id])
  providerServiceId String?    @db.VarChar(50)
  // Smart Routing + Failover: nhà cung cấp dự phòng (đẩy sang khi chính lỗi / đắt hơn / sắp hết tiền)
  backupProviderId       Int?
  backupProvider         Provider? @relation("SmmBackupProvider", fields: [backupProviderId], references: [id])
  backupProviderServiceId String?  @db.VarChar(50)
  backupCostRate         Int       @default(0) // giá vốn / 1000 tại provider dự phòng
  autoRefill             Boolean   @default(false) // tự động refill khi phát hiện tụt số sau khi hoàn thành
  active           Boolean     @default(true)
  sort             Int         @default(0)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  orders SmmOrder[]
  panelPrices PanelServicePrice[]

  @@index([providerId, providerServiceId])
}

model SmmOrder {
  id             Int            @id @default(autoincrement())
  code           String         @unique @db.VarChar(16) // SMM100001
  userId         Int
  user           User           @relation(fields: [userId], references: [id])
  serviceId      Int
  service        SmmService     @relation(fields: [serviceId], references: [id])
  link           String         @db.VarChar(500)
  quantity       Int
  charge         Int // tiền khách trả (VND)
  cost           Int            @default(0) // tiền vốn (VND)
  startCount     Int?
  remains        Int?
  status         SmmOrderStatus @default(PENDING)
  fulfillment    Fulfillment
  providerId     Int?
  provider       Provider?      @relation(fields: [providerId], references: [id])
  providerOrderId String?       @db.VarChar(50)
  viaApi         Boolean        @default(false) // đặt qua API reseller
  panelId        Int? // đơn đặt qua panel con — chủ panel hưởng commission
  panel          ChildPanel?    @relation(fields: [panelId], references: [id])
  commission     Int            @default(0) // hoa hồng đã trả cho chủ panel (VND)
  params         String?        @db.Text // JSON tham số phụ kiểu ThaTim: comments, reaction, minutes, duration, posts
  note           String?        @db.Text // ghi chú của khách
  adminNote      String?        @db.Text
  flagNote       String?        @db.VarChar(255) // cờ rủi ro/trùng đơn do hệ thống gắn (Duplicate/Risk Detection)
  promoCode      String?        @db.VarChar(40)
  promoDiscount  Int            @default(0)
  events         OrderEvent[]
  refundedAmount Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([userId, createdAt])
  @@index([status, fulfillment])
}

model PremiumCategory {
  id     Int     @id @default(autoincrement())
  name   String  @db.VarChar(100)
  slug   String  @unique @db.VarChar(100)
  sort   Int     @default(0)
  active Boolean @default(true)

  products PremiumProduct[]
}

enum PremiumFulfillment {
  AUTO_STOCK // có kho: giao ngay khi mua
  MANUAL // admin giao tay (nâng cấp chính chủ, add family/team...)
  API // dự phòng: đẩy qua API đối tác (xử lý như MANUAL nếu chưa cấu hình)
}

model PremiumProduct {
  id          Int                @id @default(autoincrement())
  categoryId  Int
  category    PremiumCategory    @relation(fields: [categoryId], references: [id])
  name        String             @db.VarChar(150)
  slug        String             @unique @db.VarChar(150)
  tagline     String?            @db.VarChar(255)
  description String?            @db.Text
  color       String             @default("#3178fc") @db.VarChar(9) // màu nhận diện thẻ
  fulfillment PremiumFulfillment @default(MANUAL)
  providerId       Int?
  provider         Provider? @relation(fields: [providerId], references: [id])
  providerProductId String?  @db.VarChar(50) // ID sản phẩm phía nhà cung cấp (khi fulfillment = API)
  customFields String?  @db.Text // JSON: trường tuỳ chỉnh khách điền khi mua [{label,type,required,placeholder,options}]
  buyNote     String?  @db.VarChar(500) // hướng dẫn riêng của sản phẩm, hiện trong hộp phía trên form mua (kiểu thatim)
  imageUrl    String?  @db.VarChar(500) // ảnh sản phẩm hiện ở trang chi tiết
  usageGuide  String?  @db.Text // hướng dẫn sử dụng sau khi mua
  warrantyInfo String? @db.Text // thông tin/điều kiện bảo hành riêng của sản phẩm
  active      Boolean            @default(true)
  sort        Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  variants PremiumVariant[]
}

model PremiumVariant {
  id          Int            @id @default(autoincrement())
  productId   Int
  product     PremiumProduct @relation(fields: [productId], references: [id])
  name        String         @db.VarChar(100) // "1 tháng", "1 năm"...
  price       Int // VND
  cost        Int            @default(0)
  warrantyDays Int           @default(0)
  providerCycle Int? // chu kỳ tháng phía nhà cung cấp (1, 3, 6, 12) — bắt buộc khi sản phẩm đấu API kiểu ThaTim
  active      Boolean        @default(true)
  sort        Int            @default(0)

  stocks PremiumStock[]
  orders PremiumOrder[]
}

enum StockStatus {
  AVAILABLE
  SOLD
}

model PremiumStock {
  id        Int            @id @default(autoincrement())
  variantId Int
  variant   PremiumVariant @relation(fields: [variantId], references: [id])
  payload   String         @db.Text // nội dung giao: tài khoản / mã / hướng dẫn
  status    StockStatus    @default(AVAILABLE)
  orderId   Int?
  createdAt DateTime       @default(now())

  @@index([variantId, status])
}

enum PremiumOrderStatus {
  PENDING // chờ admin giao (thủ công)
  DELIVERED // đã giao (tự động hoặc admin vừa giao)
  COMPLETED
  WARRANTY // đang bảo hành / đổi acc
  CANCELED
  REFUNDED
}

model PremiumOrder {
  id            Int                @id @default(autoincrement())
  code          String             @unique @db.VarChar(16) // PRE100001
  userId        Int
  user          User               @relation(fields: [userId], references: [id])
  variantId     Int
  variant       PremiumVariant     @relation(fields: [variantId], references: [id])
  quantity      Int                @default(1)
  total         Int
  cost          Int                @default(0)
  status        PremiumOrderStatus @default(PENDING)
  providerId    Int?
  provider      Provider?          @relation(fields: [providerId], references: [id])
  providerOrderId String?          @db.VarChar(60) // order_code phía nhà cung cấp (kiểu ThaTim: _8488103)
  panelId       Int? // đơn mua qua panel con — chủ panel hưởng commission
  panel         ChildPanel?        @relation(fields: [panelId], references: [id])
  commission    Int                @default(0) // hoa hồng đã trả cho chủ panel (VND)
  buyerInfo     String?            @db.Text // email/tài khoản khách cần nâng cấp (gói MANUAL)
  promoCode     String?            @db.VarChar(40)
  promoDiscount Int                @default(0)
  deliveryData  String?            @db.Text // nội dung đã giao (kho hoặc admin nhập)
  warrantyUntil DateTime?
  adminNote     String?            @db.Text
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([userId, createdAt])
  @@index([status])
}

enum DepositMethod {
  BANK
  MOMO
  CARD
  USDT
  PAYPAL
  STRIPE
}

enum DepositStatus {
  PENDING
  APPROVED
  REJECTED
}

model Deposit {
  id        Int           @id @default(autoincrement())
  code      String        @unique @db.VarChar(16) // NAP100001
  userId    Int
  user      User          @relation(fields: [userId], references: [id])
  method    DepositMethod @default(BANK)
  amount    Int
  bonus     Int           @default(0)
  status    DepositStatus @default(PENDING)
  content   String?       @db.VarChar(100) // nội dung chuyển khoản
  externalId String?      @unique @db.VarChar(90) // mã phiên phía PayPal/Stripe — chống cộng trùng
  usdCents  Int? // số USD đã thu (cent) với cổng quốc tế
  auto      Boolean       @default(false) // cộng qua webhook
  adminNote String?       @db.VarChar(255)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([userId, createdAt])
  @@index([status])
}

enum TxType {
  DEPOSIT
  SMM_ORDER
  PREMIUM_ORDER
  REFUND
  ADJUST
  BONUS
  PANEL_COMMISSION
  REFERRAL_COMMISSION
}

model Transaction {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id])
  type         TxType
  amount       Int // + cộng / - trừ
  balanceAfter Int
  ref          String?  @db.VarChar(30)
  note         String?  @db.VarChar(255)
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

enum TicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

model Ticket {
  id        Int          @id @default(autoincrement())
  userId    Int
  user      User         @relation(fields: [userId], references: [id])
  subject   String       @db.VarChar(200)
  category  String       @default("other") @db.VarChar(30) // smm | premium | deposit | other
  status    TicketStatus @default(OPEN)
  priority  String       @default("normal") @db.VarChar(10)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  messages TicketMessage[]
}

model TicketMessage {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fromAdmin Boolean  @default(false)
  body      String   @db.Text
  createdAt DateTime @default(now())
}

model Announcement {
  id        Int      @id @default(autoincrement())
  title     String   @db.VarChar(200)
  body      String   @db.Text
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Cấu hình site dạng key-value: site_name, bank_*, momo_*, deposit_bonus_tiers,
// support_*, maintenance...
model Setting {
  key   String @id @db.VarChar(80)
  value String @db.Text
}

model ApiLog {
  id        Int      @id @default(autoincrement())
  kind      String   @db.VarChar(30) // provider_out | reseller_in | webhook
  ref       String?  @db.VarChar(100)
  detail    String?  @db.Text
  ok        Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
}

// Panel con (child panel): gian hàng riêng của đại lý — khách của panel trả giá đã cộng
// markup của chủ panel, phần chênh lệch trả về chủ panel dưới dạng hoa hồng (PANEL_COMMISSION).
// Chạy tại /cua-hang/[slug] hoặc tên miền riêng của chủ panel (CNAME -> middleware nhận diện).
model ChildPanel {
  id        Int      @id @default(autoincrement())
  ownerId   Int      @unique
  owner     User     @relation("PanelOwner", fields: [ownerId], references: [id])
  name      String   @db.VarChar(120)
  slug      String   @unique @db.VarChar(60)
  domain    String?  @unique @db.VarChar(190)
  markup    Int      @default(20) // % cộng trên giá gốc
  // Giảm giá riêng theo cấp bậc của khách panel (% tính trên giá panel, lấy từ phần hoa hồng của chủ panel)
  discountMember   Int @default(0)
  discountReseller Int @default(5)
  discountAgency   Int @default(10)
  discountVip      Int @default(15)
  accent    String   @default("blue") @db.VarChar(20)
  tagline   String?  @db.VarChar(255)
  support   String?  @db.VarChar(255) // liên hệ hỗ trợ riêng của panel (Zalo/Telegram/link)
  supportZalo     String? @db.VarChar(120)
  supportTelegram String? @db.VarChar(120)
  supportFacebook String? @db.VarChar(120)
  supportHotline  String? @db.VarChar(120)
  announcement String? @db.VarChar(500) // thông báo riêng của panel, hiện trên landing con
  apiKey    String?  @db.VarChar(64) // API key tài khoản mẹ mà panel liên kết (nhập ở trang setup lần đầu)
  apiUserId Int? // tài khoản mẹ sở hữu API key trên
  setupDone Boolean  @default(false) // đã qua trang cấu hình lần đầu
  status    String   @default("ACTIVE") @db.VarChar(20) // ACTIVE | SUSPENDED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members User[]     @relation("PanelMember")
  orders  SmmOrder[]
  premiumOrders PremiumOrder[]
  servicePrices PanelServicePrice[]
}

// Giá riêng của panel cho TỪNG dịch vụ theo TỪNG cấp bậc khách (kiểu thatim:
// bảng giá có một cột giá cho mỗi cấp). Có giá riêng thì đó là giá cuối cho bậc đó.
model PanelServicePrice {
  id        Int        @id @default(autoincrement())
  panelId   Int
  panel     ChildPanel @relation(fields: [panelId], references: [id], onDelete: Cascade)
  serviceId Int
  service   SmmService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  level     UserLevel
  price     Int // giá bán /1000 tại panel cho đúng bậc này (đã gồm markup)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([panelId, serviceId, level])
  @@index([panelId])
}

// Lịch sử thay đổi trạng thái của 1 đơn SMM (Order Tracking 2.0)
model OrderEvent {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     SmmOrder @relation(fields: [orderId], references: [id])
  status    String   @db.VarChar(20)
  note      String?  @db.VarChar(255)
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

// Thông báo riêng cho từng khách (đơn hoàn thành/lỗi/hoàn tiền...)
model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  title     String   @db.VarChar(150)
  body      String   @db.VarChar(500)
  link      String?  @db.VarChar(200)
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
}


// Mã giảm giá: áp khi đặt đơn SMM / mua Premium (kiểu panel mẫu)
model DiscountCode {
  id          Int       @id @default(autoincrement())
  code        String    @unique @db.VarChar(40)
  type        String    @default("PERCENT") @db.VarChar(10) // PERCENT | FIXED
  value       Int // % giảm hoặc số tiền giảm
  minOrder    Int       @default(0)
  maxDiscount Int       @default(0) // trần giảm cho loại %, 0 = không trần
  usageLimit  Int       @default(0) // 0 = không giới hạn
  usedCount   Int       @default(0)
  scope       String    @default("ALL") @db.VarChar(10) // ALL | SMM | PREMIUM
  startsAt    DateTime?
  endsAt      DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
}

// Tài khoản ngân hàng nhận nạp — quản lý dạng thẻ ở admin
model BankAccount {
  id            Int      @id @default(autoincrement())
  bankName      String   @db.VarChar(80)
  accountNumber String   @db.VarChar(40)
  holder        String   @db.VarChar(80)
  branch        String?  @db.VarChar(80)
  qrImage       String?  @db.VarChar(300)
  note          String?  @db.VarChar(200)
  active        Boolean  @default(true)
  sort          Int      @default(0)
  createdAt     DateTime @default(now())
}

model PostCategory {
  id          Int     @id @default(autoincrement())
  name        String  @db.VarChar(80)
  slug        String  @unique @db.VarChar(90)
  description String? @db.VarChar(255)
  active      Boolean @default(true)
  posts       Post[]
}

model Post {
  id         Int           @id @default(autoincrement())
  title      String        @db.VarChar(200)
  slug       String        @unique @db.VarChar(220)
  excerpt    String?       @db.VarChar(300)
  content    String        @db.Text
  coverUrl   String?       @db.VarChar(300)
  categoryId Int?
  category   PostCategory? @relation(fields: [categoryId], references: [id])
  published  Boolean       @default(false)
  views      Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model IpBan {
  id        Int      @id @default(autoincrement())
  ip        String   @unique @db.VarChar(64)
  reason    String?  @db.VarChar(255)
  createdAt DateTime @default(now())
}
