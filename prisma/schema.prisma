// SMMv2 — SMM Panel + Premium Shop
// Tiền tệ: VND lưu dạng Int (đồng) để tránh lỗi thập phân.
// Đổi sang Postgres: provider = "postgresql" + DATABASE_URL tương ứng.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  STAFF
  ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
}

// Cấp khách: chiết khấu % áp trên giá dịch vụ SMM
enum UserLevel {
  MEMBER // 0%
  RESELLER // 5%
  AGENCY // 10%
  VIP // 15%
}

model User {
  id             Int        @id @default(autoincrement())
  username       String     @unique @db.VarChar(50)
  email          String     @unique @db.VarChar(191)
  phone          String?    @db.VarChar(20)
  fullName       String?    @db.VarChar(100)
  passwordHash   String     @db.VarChar(191)
  role           Role       @default(USER)
  status         UserStatus @default(ACTIVE)
  level          UserLevel  @default(MEMBER)
  balance        Int        @default(0) // VND
  totalDeposited Int        @default(0)
  totalSpent     Int        @default(0)
  apiKey         String     @unique @db.VarChar(64)
  depositCode    String     @unique @db.VarChar(12) // nội dung CK: SMM <code>
  refCode        String?    @unique @db.VarChar(12) // mã giới thiệu (trang Kiếm tiền)
  webhookUrl     String?    @db.VarChar(255) // URL nhận thông báo trạng thái đơn (Webhook ra hệ thống ngoài của khách)
  termsAcceptedVersion Int  @default(0) // phiên bản điều khoản đã xác nhận (đối chiếu settings terms_version)
  referredById   Int? // người đã giới thiệu tài khoản này
  referredBy     User?      @relation("Referral", fields: [referredById], references: [id])
  referrals      User[]     @relation("Referral")
  lastLoginAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  smmOrders     SmmOrder[]
  premiumOrders PremiumOrder[]
  campaigns     Campaign[]
  subscriptions Subscription[]
  deposits      Deposit[]
  transactions  Transaction[]
  tickets       Ticket[]
  notifications Notification[]

  // Panel con (child panel): khách đăng ký qua panel của đại lý khác
  panelId    Int?
  panel      ChildPanel?  @relation("PanelMember", fields: [panelId], references: [id])
  ownedPanel ChildPanel?  @relation("PanelOwner")
  staffOf    PanelStaff[] @relation("PanelStaffUser")
}

enum Fulfillment {
  API // tự động đẩy qua nhà cung cấp
  MANUAL // admin xử lý tay trong hàng đợi
}

enum ProviderKind {
  SMM // chỉ dịch vụ social
  PREMIUM // chỉ sản phẩm (API mua sản phẩm kiểu ThaTim)
  BOTH // cả hai (vd ThaTim)
}

model Provider {
  id            Int          @id @default(autoincrement())
  kind          ProviderKind @default(BOTH)
  name          String       @db.VarChar(100)
  apiUrl        String   @db.VarChar(255) // vd https://slike.vn/api/v2
  apiKey        String   @db.VarChar(191)
  currency      String   @default("VND") @db.VarChar(10) // VND | USD
  exchangeRate  Int      @default(1) // 1 đơn vị tiền gốc = ? VND (USD: 26000)
  markupPercent Int      @default(30) // % cộng lãi khi đồng bộ dịch vụ
  syncServices    Boolean @default(true) // cho phép đồng bộ dịch vụ
  syncCategories  Boolean @default(true) // cho phép đồng bộ danh mục
  autoUpdatePrice Boolean @default(true) // tự cập nhật giá khi đồng bộ
  syncContent     Boolean @default(false) // đồng bộ cả tên + mô tả dịch vụ khi sync
  filterHtml      Boolean @default(true) // lọc thẻ HTML khỏi mô tả khi đồng bộ
  syncAdvanced    Boolean @default(false) // đồng bộ nâng cao: refill / cancel / dripfeed
  coupon          String? @db.VarChar(60) // mã giảm giá phía API của nhà cung cấp (nếu có)
  cronSyncLimit   Int     @default(50) // giới hạn số đơn đồng bộ mỗi vòng cron cho nguồn này
  minBalanceAlert Int     @default(0) // ngưỡng cảnh báo số dư thấp (VNĐ quy đổi)
  dailyLimit      Int     @default(0) // giới hạn đặt hàng tối đa mỗi ngày (0 = không giới hạn)
  balanceCache  Int      @default(0) // số dư quy VND, cập nhật khi check
  active        Boolean  @default(true)
  note          String?  @db.Text
  lastSyncAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  services      SmmService[] @relation("SmmMainProvider")
  backupServices SmmService[] @relation("SmmBackupProvider")
  orders        SmmOrder[]
  premiumProducts PremiumProduct[]
  premiumOrders   PremiumOrder[]
}

model SmmCategory {
  id       Int     @id @default(autoincrement())
  platform String  @db.VarChar(30) // facebook | tiktok | instagram | youtube | telegram | shopee | x | spotify | other
  name     String  @db.VarChar(120)
  sort     Int     @default(0)
  active   Boolean @default(true)

  services SmmService[]
}

enum SmmOrderStatus {
  PENDING
  PROCESSING
  IN_PROGRESS
  COMPLETED
  PARTIAL
  CANCELED
  REFUNDED
}

model SmmService {
  id               Int         @id @default(autoincrement())
  panelId          Int? // dịch vụ riêng của 1 panel con; null = dịch vụ của web mẹ
  panel            ChildPanel? @relation("PanelOwnServices", fields: [panelId], references: [id])
  categoryId       Int
  category         SmmCategory @relation(fields: [categoryId], references: [id])
  name             String      @db.VarChar(255)
  description      String?     @db.Text
  notice           String?     @db.Text // thông báo dịch vụ: hiện nổi bật cho khách khi đặt đơn (vd đang chậm, bảo trì)
  rate             Int // giá bán / 1000 (VND, trước chiết khấu cấp khách)
  costRate         Int         @default(0) // giá vốn / 1000 (VND)
  min              Int         @default(10)
  max              Int         @default(100000)
  avgTime          String?     @db.VarChar(60) // "0-15 phút", "1-2 giờ"...
  type             String      @default("Default") @db.VarChar(30) // Default | Comments | Reactions | WatchTime...
  customMarkup     Int? // % lãi riêng của dịch vụ (đè % của nhà cung cấp khi đồng bộ)
  refill           Boolean     @default(false)
  cancelable       Boolean     @default(false)
  dripfeed         Boolean     @default(false)
  fulfillment      Fulfillment @default(MANUAL)
  providerId       Int?
  provider         Provider?   @relation("SmmMainProvider", fields: [providerId], references: [id])
  providerServiceId String?    @db.VarChar(50)
  // Smart Routing + Failover: nhà cung cấp dự phòng (đẩy sang khi chính lỗi / đắt hơn / sắp hết tiền)
  backupProviderId       Int?
  backupProvider         Provider? @relation("SmmBackupProvider", fields: [backupProviderId], references: [id])
  backupProviderServiceId String?  @db.VarChar(50)
  backupCostRate         Int       @default(0) // giá vốn / 1000 tại provider dự phòng
  autoRefill             Boolean   @default(false) // tự động refill khi phát hiện tụt số sau khi hoàn thành
  autoSyncPrice          Boolean   @default(true) // tự cập nhật giá bán theo giá vốn NCC khi đồng bộ
  qtyAdjustPercent       Int       @default(0) // điều chỉnh % số lượng khi đẩy sang API (+tăng / -giảm)
  autoUid                Boolean   @default(false) // tự lấy UID từ link khi đẩy đơn
  telegramBot            String?   @db.VarChar(60) // bot Telegram báo đơn riêng (id trong settings telegram_bots; null = bot hệ thống)
  active           Boolean     @default(true)
  sort             Int         @default(0)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  subscriptions    Subscription[]

  orders SmmOrder[]
  panelPrices PanelServicePrice[]

  @@index([providerId, providerServiceId])
}

model SmmOrder {
  id             Int            @id @default(autoincrement())
  code           String         @unique @db.VarChar(16) // SMM100001
  userId         Int
  user           User           @relation(fields: [userId], references: [id])
  serviceId      Int
  service        SmmService     @relation(fields: [serviceId], references: [id])
  link           String         @db.VarChar(500)
  quantity       Int
  charge         Int // tiền khách trả (VND)
  cost           Int            @default(0) // tiền vốn (VND)
  startCount     Int?
  remains        Int?
  status         SmmOrderStatus @default(PENDING)
  fulfillment    Fulfillment
  providerId     Int?
  provider       Provider?      @relation(fields: [providerId], references: [id])
  providerOrderId String?       @db.VarChar(50)
  viaApi         Boolean        @default(false) // đặt qua API reseller
  panelId        Int? // đơn đặt qua panel con — chủ panel hưởng commission
  campaignId     Int?
  campaign       Campaign?  @relation(fields: [campaignId], references: [id])
  subscriptionId Int?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  panel          ChildPanel?    @relation(fields: [panelId], references: [id])
  commission     Int            @default(0) // hoa hồng đã trả cho chủ panel (VND)
  params         String?        @db.Text // JSON tham số phụ kiểu ThaTim: comments, reaction, minutes, duration, posts
  note           String?        @db.Text // ghi chú của khách
  adminNote      String?        @db.Text
  flagNote       String?        @db.VarChar(255) // cờ rủi ro/trùng đơn do hệ thống gắn (Duplicate/Risk Detection)
  promoCode      String?        @db.VarChar(40)
  promoDiscount  Int            @default(0)
  events         OrderEvent[]
  refundedAmount Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([userId, createdAt])
  @@index([status, fulfillment])
}

model PremiumCategory {
  id          Int     @id @default(autoincrement())
  name        String  @db.VarChar(100)
  slug        String  @unique @db.VarChar(100)
  description String? @db.Text
  icon        String? @db.VarChar(60)
  sort        Int     @default(0)
  active      Boolean @default(true)

  products PremiumProduct[]
}

enum PremiumFulfillment {
  AUTO_STOCK // có kho: giao ngay khi mua
  MANUAL // admin giao tay (nâng cấp chính chủ, add family/team...)
  API // dự phòng: đẩy qua API đối tác (xử lý như MANUAL nếu chưa cấu hình)
}

model PremiumProduct {
  id          Int                @id @default(autoincrement())
  categoryId  Int
  category    PremiumCategory    @relation(fields: [categoryId], references: [id])
  name        String             @db.VarChar(150)
  slug        String             @unique @db.VarChar(150)
  tagline     String?            @db.VarChar(255)
  description String?            @db.Text
  color       String             @default("#3178fc") @db.VarChar(9) // màu nhận diện thẻ
  fulfillment PremiumFulfillment @default(MANUAL)
  providerId       Int?
  provider         Provider? @relation(fields: [providerId], references: [id])
  providerProductId String?  @db.VarChar(50) // ID sản phẩm phía nhà cung cấp (khi fulfillment = API)
  customFields String?  @db.Text // JSON: trường tuỳ chỉnh khách điền khi mua [{label,type,required,placeholder,options}]
  buyNote     String?  @db.VarChar(500) // hướng dẫn riêng của sản phẩm, hiện trong hộp phía trên form mua (kiểu thatim)
  imageUrl    String?  @db.VarChar(500) // ảnh sản phẩm hiện ở trang chi tiết
  usageGuide  String?  @db.Text // hướng dẫn sử dụng sau khi mua
  warrantyInfo String? @db.Text // thông tin/điều kiện bảo hành riêng của sản phẩm
  active      Boolean            @default(true)
  sort        Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  variants PremiumVariant[]
}

model PremiumVariant {
  id          Int            @id @default(autoincrement())
  productId   Int
  product     PremiumProduct @relation(fields: [productId], references: [id])
  name        String         @db.VarChar(100) // "1 tháng", "1 năm"...
  price       Int // VND
  cost        Int            @default(0)
  warrantyDays Int           @default(0)
  providerCycle Int? // chu kỳ tháng phía nhà cung cấp (1, 3, 6, 12) — bắt buộc khi sản phẩm đấu API kiểu ThaTim
  active      Boolean        @default(true)
  sort        Int            @default(0)

  stocks PremiumStock[]
  panelPrices PanelPremiumPrice[]
  orders PremiumOrder[]
}

enum StockStatus {
  AVAILABLE
  SOLD
}

model PanelPremiumPrice {
  id        Int            @id @default(autoincrement())
  panelId   Int
  panel     ChildPanel     @relation(fields: [panelId], references: [id])
  variantId Int
  variant   PremiumVariant @relation(fields: [variantId], references: [id])
  price     Int // giá cuối mỗi đơn vị do chủ panel đặt

  @@unique([panelId, variantId])
}

model PremiumStock {
  id        Int            @id @default(autoincrement())
  variantId Int
  variant   PremiumVariant @relation(fields: [variantId], references: [id])
  payload   String         @db.Text // nội dung giao: tài khoản / mã / hướng dẫn
  status    StockStatus    @default(AVAILABLE)
  orderId   Int?
  createdAt DateTime       @default(now())

  @@index([variantId, status])
}

enum PremiumOrderStatus {
  PENDING // chờ admin giao (thủ công)
  DELIVERED // đã giao (tự động hoặc admin vừa giao)
  COMPLETED
  WARRANTY // đang bảo hành / đổi acc
  CANCELED
  REFUNDED
}

model PremiumOrder {
  id            Int                @id @default(autoincrement())
  code          String             @unique @db.VarChar(16) // PRE100001
  userId        Int
  user          User               @relation(fields: [userId], references: [id])
  variantId     Int
  variant       PremiumVariant     @relation(fields: [variantId], references: [id])
  quantity      Int                @default(1)
  total         Int
  cost          Int                @default(0)
  status        PremiumOrderStatus @default(PENDING)
  providerId    Int?
  provider      Provider?          @relation(fields: [providerId], references: [id])
  providerOrderId String?          @db.VarChar(60) // order_code phía nhà cung cấp (kiểu ThaTim: _8488103)
  panelId       Int? // đơn mua qua panel con — chủ panel hưởng commission
  panel         ChildPanel?        @relation(fields: [panelId], references: [id])
  commission    Int                @default(0) // hoa hồng đã trả cho chủ panel (VND)
  buyerInfo     String?            @db.Text // email/tài khoản khách cần nâng cấp (gói MANUAL)
  promoCode     String?            @db.VarChar(40)
  promoDiscount Int                @default(0)
  deliveryData  String?            @db.Text // nội dung đã giao (kho hoặc admin nhập)
  warrantyUntil DateTime?
  adminNote     String?            @db.Text
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([userId, createdAt])
  @@index([status])
}

enum DepositMethod {
  BANK
  MOMO
  CARD
  USDT
  PAYPAL
  STRIPE
}

enum DepositStatus {
  PENDING
  APPROVED
  REJECTED
}

model Deposit {
  id        Int           @id @default(autoincrement())
  code      String        @unique @db.VarChar(16) // NAP100001
  userId    Int
  user      User          @relation(fields: [userId], references: [id])
  method    DepositMethod @default(BANK)
  amount    Int
  bonus     Int           @default(0)
  status    DepositStatus @default(PENDING)
  content   String?       @db.VarChar(100) // nội dung chuyển khoản
  externalId String?      @unique @db.VarChar(90) // mã phiên phía PayPal/Stripe — chống cộng trùng
  usdCents  Int? // số USD đã thu (cent) với cổng quốc tế
  auto      Boolean       @default(false) // cộng qua webhook
  adminNote String?       @db.VarChar(255)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([userId, createdAt])
  @@index([status])
}

enum TxType {
  DEPOSIT
  SMM_ORDER
  PREMIUM_ORDER
  REFUND
  ADJUST
  BONUS
  PANEL_COMMISSION
  REFERRAL_COMMISSION
}

model Transaction {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id])
  type         TxType
  amount       Int // + cộng / - trừ
  balanceAfter Int
  ref          String?  @db.VarChar(30)
  note         String?  @db.VarChar(255)
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

enum TicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

model Ticket {
  id        Int          @id @default(autoincrement())
  userId    Int
  user      User         @relation(fields: [userId], references: [id])
  subject   String       @db.VarChar(200)
  category  String       @default("other") @db.VarChar(30) // smm | premium | deposit | other
  status    TicketStatus @default(OPEN)
  priority  String       @default("normal") @db.VarChar(10)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  messages TicketMessage[]
}

model TicketMessage {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fromAdmin Boolean  @default(false)
  body      String   @db.Text
  createdAt DateTime @default(now())
}

model Announcement {
  id        Int      @id @default(autoincrement())
  title     String   @db.VarChar(200)
  body      String   @db.Text
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Cấu hình site dạng key-value: site_name, bank_*, momo_*, deposit_bonus_tiers,
// support_*, maintenance...
model ContactWidget {
  id        Int         @id @default(autoincrement())
  panelId   Int?
  panel     ChildPanel? @relation("PanelContactWidgets", fields: [panelId], references: [id], onDelete: Cascade)
  name      String      @db.VarChar(120)
  link      String      @db.VarChar(500)
  image     String?     @db.Text
  active    Boolean     @default(true)
  sort      Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Setting {
  key   String @id @db.VarChar(80)
  value String @db.Text
}

model ApiLog {
  id        Int      @id @default(autoincrement())
  kind      String   @db.VarChar(30) // provider_out | reseller_in | webhook
  ref       String?  @db.VarChar(100)
  detail    String?  @db.Text
  ok        Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
}

// Panel con (child panel): gian hàng riêng của đại lý — khách của panel trả giá đã cộng
// markup của chủ panel, phần chênh lệch trả về chủ panel dưới dạng hoa hồng (PANEL_COMMISSION).
// Chạy tại /cua-hang/[slug] hoặc tên miền riêng của chủ panel (CNAME -> middleware nhận diện).
model ChildPanel {
  id        Int      @id @default(autoincrement())
  ownerId   Int      @unique
  owner     User     @relation("PanelOwner", fields: [ownerId], references: [id])
  name      String   @db.VarChar(120)
  slug      String   @unique @db.VarChar(60)
  domain    String?  @unique @db.VarChar(190)
  markup    Int      @default(20) // % cộng trên giá gốc
  // Giảm giá riêng theo cấp bậc của khách panel (% tính trên giá panel, lấy từ phần hoa hồng của chủ panel)
  discountMember   Int @default(0)
  discountReseller Int @default(5)
  discountAgency   Int @default(10)
  discountVip      Int @default(15)
  accent    String   @default("blue") @db.VarChar(20)
  tagline   String?  @db.VarChar(255)
  support   String?  @db.VarChar(255) // liên hệ hỗ trợ riêng của panel (Zalo/Telegram/link)
  supportZalo     String? @db.VarChar(120)
  supportTelegram String? @db.VarChar(120)
  supportFacebook String? @db.VarChar(120)
  supportHotline  String? @db.VarChar(120)
  announcement String? @db.VarChar(500) // thông báo riêng của panel, hiện trên landing con
  apiKey    String?  @db.VarChar(64) // API key tài khoản mẹ mà panel liên kết (nhập ở trang setup lần đầu)
  apiUserId Int? // tài khoản mẹ sở hữu API key trên
  setupDone Boolean  @default(false) // đã qua trang cấu hình lần đầu
  // AI riêng của panel: chủ panel tự thêm key — livechat trên gian hàng dùng cấu hình này
  aiEnabled Boolean @default(false)
  aiProvider String  @default("openai") @db.VarChar(20)
  aiBaseUrl  String? @db.VarChar(200)
  aiApiKey   String? @db.Text
  aiModel    String? @db.VarChar(80)
  // Cấu hình riêng của panel (chủ panel tự cài): thanh toán / thư / báo tin / đăng nhập
  bankName        String? @db.VarChar(120)
  bankAccount     String? @db.VarChar(40)
  bankHolder      String? @db.VarChar(120)
  usdtAddress     String? @db.VarChar(120)
  usdtNetwork     String? @db.VarChar(40)
  usdtRate        Int? // tỉ giá 1 USDT = ? VND theo panel tự đặt
  smtpHost        String? @db.VarChar(120)
  smtpPort        String? @db.VarChar(10)
  smtpUser        String? @db.VarChar(160)
  smtpPass        String? @db.VarChar(200)
  smtpFrom        String? @db.VarChar(160)
  smtpSecure      Boolean @default(false)
  telegramBotToken String? @db.VarChar(120)
  telegramChatId   String? @db.VarChar(60)
  // Báo tin & báo cáo của panel (chủ panel tự cấu hình, bật/tắt từng kênh)
  alertTelegram  Boolean @default(true) // gửi báo tin qua Telegram của panel
  alertDiscord   Boolean @default(false)
  discordWebhook String? @db.VarChar(300)
  alertEmailOn   Boolean @default(false)
  alertEmail     String? @db.VarChar(160) // email nhận báo tin của chủ panel
  alertEvents    String? @db.VarChar(200) // danh sách sự kiện bật, cách nhau dấu phẩy; trống = tất cả
  reportDaily    Boolean @default(false) // gửi báo cáo ngày tự động
  reportTime     String? @db.VarChar(5) // giờ gửi báo cáo ngày "HH:MM"
  reportChannels String? @db.VarChar(60) // kênh gửi báo cáo: email,telegram,discord
  reportLastSent String? @db.VarChar(10) // ngày đã gửi báo cáo gần nhất (yyyy-mm-dd)
  googleClientId     String? @db.VarChar(200)
  // Công tắc bán hàng của panel: bán mảng nào thì bật mảng đó
  sellSmm     Boolean @default(true)
  sellPremium Boolean @default(true)
  // Mô-đun riêng của panel (như trang Mô-đun của web mẹ, phạm vi khách của panel)
  moduleAffiliate Boolean @default(true) // tắt = khách panel không có mục Kiếm tiền + không tính hoa hồng giới thiệu
  moduleRegister  Boolean @default(true) // tắt = gian hàng ngừng nhận đăng ký mới
  // Tỉ giá quy đổi HIỂN THỊ riêng của panel (để trống = dùng tỉ giá của web mẹ; tiền thật vẫn là VNĐ)
  rateUsd String? @db.VarChar(20)
  rateEur String? @db.VarChar(20)
  rateCny String? @db.VarChar(20)
  rateThb String? @db.VarChar(20)
  rateJpy String? @db.VarChar(20)
  rateKrw String? @db.VarChar(20)
  // Danh mục bị ẩn trên gian hàng của panel (id danh mục SMM, cách nhau dấu phẩy)
  hiddenCats String? @db.VarChar(300)
  // Method nạp quốc tế RIÊNG của panel (như web mẹ): khách panel trả qua tài khoản
  // PayPal/Stripe CỦA CHỦ PANEL; panel chưa cấu hình thì dùng cổng của web mẹ.
  paypalEnabled Boolean @default(false)
  paypalClientId String? @db.VarChar(200)
  paypalSecret   String? @db.VarChar(200)
  paypalMode     String? @db.VarChar(10) // sandbox | live
  stripeEnabled Boolean @default(false)
  stripeSecretKey String? @db.VarChar(200)
  stripeWebhookSecret String? @db.VarChar(200)
  // Nạp ngân hàng TỰ ĐỘNG riêng của panel qua SePay của CHỦ PANEL (tiền về ngân hàng
  // của panel, webhook nhận diện bằng secret riêng). Chưa bật thì khách dùng cổng chung của web mẹ.
  sepayEnabled Boolean @default(false)
  sepaySecret  String? @db.VarChar(200) // secret webhook SePay của panel
  // Chính sách nạp riêng của panel (trống = dùng của web mẹ)
  depositBonusTiers String? @db.Text // JSON [{from, percent}] như web mẹ
  depositMin Int? // nạp tối thiểu riêng (VNĐ)
  affiliatePercent Int? // % hoa hồng giới thiệu riêng cho khách của panel
  googleClientSecret String? @db.VarChar(200)
  ownServices SmmService[] @relation("PanelOwnServices")
  status    String   @default("ACTIVE") @db.VarChar(20) // ACTIVE | SUSPENDED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members User[]     @relation("PanelMember")
  staff   PanelStaff[]
  ipBans  IpBan[]    @relation("PanelIpBans")
  bankAccounts PanelBankAccount[]
  orders  SmmOrder[]
  premiumOrders PremiumOrder[]
  servicePrices PanelServicePrice[]
  premiumPrices PanelPremiumPrice[]
  discountCodes DiscountCode[]
  posts         Post[]
  contactWidgets ContactWidget[] @relation("PanelContactWidgets")
}

// Nhân viên của panel con (phân quyền 2 tầng như web mẹ): nhân viên vào được
// Panel Admin nhưng chỉ xử lý đơn + trả lời ticket + xem khách/thống kê;
// giá, tiền, cấu hình, nhân sự là quyền của CHỦ panel.
model PanelStaff {
  id        Int        @id @default(autoincrement())
  panelId   Int
  panel     ChildPanel @relation(fields: [panelId], references: [id], onDelete: Cascade)
  userId    Int
  user      User       @relation("PanelStaffUser", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([panelId, userId])
  @@index([userId])
}

// Giá riêng của panel cho TỪNG dịch vụ theo TỪNG cấp bậc khách (kiểu thatim:
// bảng giá có một cột giá cho mỗi cấp). Có giá riêng thì đó là giá cuối cho bậc đó.
model PanelServicePrice {
  id        Int        @id @default(autoincrement())
  panelId   Int
  panel     ChildPanel @relation(fields: [panelId], references: [id], onDelete: Cascade)
  serviceId Int
  service   SmmService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  level     UserLevel
  price     Int // giá bán /1000 tại panel cho đúng bậc này (đã gồm markup)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([panelId, serviceId, level])
  @@index([panelId])
}

// Lịch sử thay đổi trạng thái của 1 đơn SMM (Order Tracking 2.0)
model OrderEvent {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     SmmOrder @relation(fields: [orderId], references: [id])
  status    String   @db.VarChar(20)
  note      String?  @db.VarChar(255)
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

// Thông báo riêng cho từng khách (đơn hoàn thành/lỗi/hoàn tiền...)
model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  title     String   @db.VarChar(150)
  body      String   @db.VarChar(500)
  link      String?  @db.VarChar(200)
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
}


// Mã giảm giá: áp khi đặt đơn SMM / mua Premium (kiểu panel mẫu)
model DiscountCode {
  id          Int       @id @default(autoincrement())
  panelId     Int? // mã riêng của 1 panel con; null = mã toàn hệ thống
  panel       ChildPanel? @relation(fields: [panelId], references: [id])
  code        String    @unique @db.VarChar(40)
  type        String    @default("PERCENT") @db.VarChar(10) // PERCENT | FIXED
  value       Int // % giảm hoặc số tiền giảm
  minOrder    Int       @default(0)
  maxDiscount Int       @default(0) // trần giảm cho loại %, 0 = không trần
  usageLimit  Int       @default(0) // 0 = không giới hạn
  usedCount   Int       @default(0)
  scope       String    @default("ALL") @db.VarChar(10) // ALL | SMM | PREMIUM
  startsAt    DateTime?
  endsAt      DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
}

// Tài khoản ngân hàng nhận nạp — quản lý dạng thẻ ở admin
model BankAccount {
  id            Int      @id @default(autoincrement())
  bankName      String   @db.VarChar(80)
  accountNumber String   @db.VarChar(40)
  holder        String   @db.VarChar(80)
  branch        String?  @db.VarChar(80)
  qrImage       String?  @db.VarChar(300)
  note          String?  @db.VarChar(200)
  active        Boolean  @default(true)
  sort          Int      @default(0)
  createdAt     DateTime @default(now())
}

model PostCategory {
  id          Int     @id @default(autoincrement())
  name        String  @db.VarChar(80)
  slug        String  @unique @db.VarChar(90)
  description String? @db.VarChar(255)
  active      Boolean @default(true)
  posts       Post[]
}

model Post {
  panelId     Int? // bài viết riêng của 1 panel con; null = bài của web mẹ
  panel       ChildPanel? @relation(fields: [panelId], references: [id])
  id         Int           @id @default(autoincrement())
  title      String        @db.VarChar(200)
  slug       String        @unique @db.VarChar(220)
  excerpt    String?       @db.VarChar(300)
  content    String        @db.Text
  coverUrl   String?       @db.VarChar(300)
  categoryId Int?
  category   PostCategory? @relation(fields: [categoryId], references: [id])
  published  Boolean       @default(false)
  views      Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model IpBan {
  id        Int         @id @default(autoincrement())
  ip        String      @db.VarChar(64)
  reason    String?     @db.VarChar(255)
  // panelId trống = cấm TOÀN HỆ THỐNG (web mẹ đặt); có panelId = chỉ cấm trong panel đó
  panelId   Int?
  panel     ChildPanel? @relation("PanelIpBans", fields: [panelId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([panelId, ip])
  @@index([ip])
}

// Tài khoản ngân hàng nhận nạp của RIÊNG panel (khách panel thấy ở trang Nạp tiền,
// chủ panel duyệt tay) — như trang Ngân hàng của web mẹ nhưng phạm vi panel.
model PanelBankAccount {
  id          Int        @id @default(autoincrement())
  panelId     Int
  panel       ChildPanel @relation(fields: [panelId], references: [id], onDelete: Cascade)
  bankName    String     @db.VarChar(120)
  accountNo   String     @db.VarChar(40)
  accountName String     @db.VarChar(120)
  note        String?    @db.VarChar(255)
  active      Boolean    @default(true)
  sort        Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([panelId])
}


// Đăng ký định kỳ (Smart Subscription): hệ thống tự đặt đơn theo lịch của khách
model Subscription {
  id            Int        @id @default(autoincrement())
  userId        Int
  user          User       @relation(fields: [userId], references: [id])
  serviceId     Int
  service       SmmService @relation(fields: [serviceId], references: [id])
  link          String     @db.VarChar(500)
  quantity      Int
  intervalDays  Int        @default(1) // cách bao nhiêu ngày chạy 1 lần
  intervalMinutes Int      @default(0) // chu kỳ theo phút cho gói Loop (0 = dùng intervalDays)
  totalRuns     Int        @default(0) // tổng số lượt sẽ chạy rồi tự dừng (0 = không giới hạn; gói Schedule = 1)
  kind          String     @default("RECURRING") @db.VarChar(20) // RECURRING | SCHEDULE | LOOP
  dailyBudget   Int        @default(0) // trần chi cho các đơn định kỳ trong 1 ngày (0 = không giới hạn)
  targetTotal   Int        @default(0) // tổng số lượng mục tiêu — đạt là tự tạm dừng (0 = không đặt)
  deliveredQty  Int        @default(0) // tổng số lượng đã đặt qua gói này
  runs          Int        @default(0)
  active        Boolean    @default(true)
  lastRunAt     DateTime?
  nextRunAt     DateTime
  lastError     String?    @db.VarChar(255)
  createdAt     DateTime   @default(now())
  orders        SmmOrder[]

  @@index([active, nextRunAt])
}

// Chiến dịch (Campaign Manager): gom đơn theo chiến dịch + ngân sách
model Campaign {
  id        Int        @id @default(autoincrement())
  userId    Int
  user      User       @relation(fields: [userId], references: [id])
  name      String     @db.VarChar(120)
  budget    Int        @default(0) // ngân sách dự kiến (0 = không đặt)
  note      String?    @db.VarChar(255)
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  orders    SmmOrder[]
}

// Chống brute-force đăng nhập: đếm lần sai theo khoá (ip|username), khoá tạm khi vượt ngưỡng
model LoginThrottle {
  key         String    @id @db.VarChar(191)
  fails       Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

// Nhật ký đăng ký theo IP (giới hạn số tài khoản tạo mỗi IP / giờ ở Cài đặt → Bảo mật)
model RegAttempt {
  id        Int      @id @default(autoincrement())
  ip        String   @db.VarChar(64)
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}
