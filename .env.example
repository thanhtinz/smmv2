# ===== Bắt buộc =====
# MySQL / MariaDB (VPS) — hoặc Postgres bằng cách đổi provider trong prisma/schema.prisma
DATABASE_URL="mysql://root:password@localhost:3306/smmv2"
# Chuỗi bí mật ký phiên đăng nhập (>= 32 ký tự, tự đặt ngẫu nhiên)
AUTH_SECRET="doi-chuoi-nay-thanh-mot-chuoi-ngau-nhien-dai-32-ky-tu"
# Khoá gọi /api/cron/* (đồng bộ đơn + trạng thái provider)
CRON_SECRET="doi-chuoi-nay-nua"

# ===== Tuỳ chọn =====
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Tên miền chính của web mẹ (không có http/https) — dùng để nhận diện domain riêng của panel con
MAIN_HOST="tenmienchinh.com"
# Tên miền chính của web mẹ — để nhận diện domain riêng của panel con (domain con trỏ về cùng server sẽ tự mở gian hàng + trang quản trị của panel đó tại /admin)
# SePay: webhook secret để tự động cộng tiền khi khách chuyển khoản đúng nội dung
SEPAY_WEBHOOK_SECRET=""
